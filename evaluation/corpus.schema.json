{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Z-Privesc Evaluation Corpus",
  "description": "Schema for a versioned corpus of privilege-escalation targets with explicit ground truth and optional exploit-verification commands used for confidence calibration.",
  "type": "object",
  "required": ["schema", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^zp-eval/corpus/v[0-9]+$",
      "description": "Manifest schema version, e.g. zp-eval/corpus/v1."
    },
    "description": { "type": "string" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provisioner": { "type": "string", "enum": ["multipass", "docker", "ssh"] },
        "zp_binary": { "type": "string" },
        "timeout_sec": { "type": "integer", "minimum": 1 },
        "baselines": {
          "type": "array",
          "items": { "type": "string", "enum": ["linpeas", "lynis"] }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/target" }
    }
  },
  "definitions": {
    "target": {
      "type": "object",
      "required": ["id", "provisioner", "setup", "teardown", "ground_truth"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "distro": { "type": "string" },
        "release": { "type": "string" },
        "kernel": { "type": "string" },
        "provisioner": { "type": "string", "enum": ["multipass", "docker", "ssh"] },
        "image": { "type": "string", "description": "multipass image name or docker image ref." },
        "host": { "type": "string", "description": "SSH host (provisioner=ssh)." },
        "setup": { "type": "string", "description": "Path to a setup shell script (planted state)." },
        "teardown": { "type": "string", "description": "Path to a teardown shell script." },
        "timeout_sec": { "type": "integer", "minimum": 1 },
        "baselines": {
          "type": "array",
          "items": { "type": "string", "enum": ["linpeas", "lynis"] }
        },
        "ground_truth": { "$ref": "#/definitions/ground_truth" },
        "verify_steps": {
          "type": "array",
          "description": "Per-step exploit verification used for calibration.",
          "items": { "$ref": "#/definitions/verify" }
        },
        "verify_paths": {
          "type": "array",
          "description": "End-to-end path exploit verification.",
          "items": { "$ref": "#/definitions/verify" }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reachable_tokens": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Capability tokens that should be derivable, e.g. WRITE_SUDOERS."
        },
        "expected_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path technique labels that must be reported, e.g. 'WRITE_SUDOERS -> root'."
        },
        "expected_findings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Finding ids that must appear, e.g. WETC-D-004."
        },
        "root_reachable": {
          "type": "boolean",
          "description": "Whether the target grants root overall. Defaults to (expected_paths non-empty)."
        },
        "notes": { "type": "string" }
      }
    },
    "verify": {
      "type": "object",
      "required": ["cmd"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "Matches a path technique or step technique." },
        "cmd": { "type": "string", "description": "Command; exit 0 = success (exploit worked), non-zero = failure." },
        "user": { "type": "string", "description": "Optional user to run as (e.g. the unprivileged victim)." },
        "timeout_sec": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
