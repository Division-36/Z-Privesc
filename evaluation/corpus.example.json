{
  "schema": "zp-eval/corpus/v1",
  "description": "Reference corpus seeded from the in-repo testbeds/. Each target plants one known misconfiguration; ground_truth and verify (rule-technique labels) are explicit so detection and calibration are reproducible. Scale this out to >=40 targets (CTF/Docker/CVE) before submission. NOTE: verify_steps/verify_paths 'label' MUST equal a rule 'tech' string in src/compose.c so outcomes attribute to the right reliability weight.",
  "defaults": {
    "provisioner": "multipass",
    "zp_binary": "./build/bin/z_privesc",
    "timeout_sec": 300,
    "baselines": ["linpeas", "lynis"]
  },
  "targets": [
    {
      "id": "primary-sudoers-nopasswd",
      "distro": "ubuntu", "release": "22.04", "kernel": "5.15",
      "provisioner": "multipass", "image": "ubuntu:22.04",
      "setup": "testbeds/sudoers/setup.sh",
      "teardown": "testbeds/sudoers/cleanup.sh",
      "ground_truth": {
        "reachable_tokens": ["EXEC_AS_ROOT", "ROOT"],
        "expected_paths": ["EXEC_AS_ROOT -> root"],
        "expected_findings": ["SUDO-00001"],
        "notes": "NOPASSWD sudoers grants direct root execution."
      },
      "verify_steps": [
        { "label": "execute code as root", "cmd": "sudo -n true", "user": "ubuntu" }
      ],
      "verify_paths": [
        { "label": "execute code as root", "cmd": "sudo -n true", "user": "ubuntu" }
      ]
    },
    {
      "id": "primary-writable-etc-sudoers",
      "distro": "ubuntu", "release": "22.04", "kernel": "5.15",
      "provisioner": "multipass", "image": "ubuntu:22.04",
      "setup": "testbeds/writable_etc/setup.sh",
      "teardown": "testbeds/writable_etc/cleanup.sh",
      "ground_truth": {
        "reachable_tokens": ["WRITE_SUDOERS", "EXEC_AS_ROOT", "ROOT"],
        "expected_paths": ["WRITE_SUDOERS -> root"],
        "expected_findings": ["WETC-D-004"],
        "notes": "World-writable sudoers.d drop-in grants NOPASSWD."
      },
      "verify_steps": [
        { "label": "append NOPASSWD to sudoers", "cmd": "echo '%sudo ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/zp-verify >/dev/null && sudo -n true", "user": "ubuntu" }
      ],
      "verify_paths": [
        { "label": "execute code as root", "cmd": "sudo -n true", "user": "ubuntu" }
      ]
    },
    {
      "id": "primary-suid-root",
      "distro": "ubuntu", "release": "22.04", "kernel": "5.15",
      "provisioner": "multipass", "image": "ubuntu:22.04",
      "setup": "testbeds/suid/setup.sh",
      "teardown": "testbeds/suid/cleanup.sh",
      "ground_truth": {
        "reachable_tokens": ["EXEC_AS_ROOT", "ROOT"],
        "expected_paths": ["EXEC_AS_ROOT -> root"],
        "expected_findings": ["SUID-ROOT"],
        "notes": "Dangerous SUID shell binary."
      },
      "verify_paths": [
        { "label": "execute code as root", "cmd": "id -u", "user": "ubuntu" }
      ]
    },
    {
      "id": "primary-docker-socket",
      "distro": "ubuntu", "release": "22.04", "kernel": "5.15",
      "provisioner": "multipass", "image": "ubuntu:22.04",
      "setup": "testbeds/docker/setup.sh",
      "teardown": "testbeds/docker/cleanup.sh",
      "ground_truth": {
        "reachable_tokens": ["CONTAINER_ESCAPE", "ROOT"],
        "expected_paths": ["CONTAINER_ESCAPE -> root"],
        "expected_findings": ["DOCK-001"],
        "notes": "Mounted /var/run/docker.sock; group membership escapes to host root."
      },
      "verify_steps": [
        { "label": "escape container to host root", "cmd": "docker ps >/dev/null 2>&1", "user": "ubuntu" }
      ],
      "verify_paths": [
        { "label": "escape container to host root", "cmd": "docker run --rm -v /:/host alpine chroot /host id -u", "user": "ubuntu" }
      ]
    },
    {
      "id": "primary-ssh-root-key",
      "distro": "ubuntu", "release": "22.04", "kernel": "5.15",
      "provisioner": "multipass", "image": "ubuntu:22.04",
