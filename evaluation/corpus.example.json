        "expected_paths": ["READ_ROOT_KEY -> root"],
        "expected_findings": ["SSH-00001"],
        "notes": "Readable root private key."
      },
      "verify_paths": [
        { "label": "SSH in as root with stolen key", "cmd": "ssh -o BatchMode=yes -o StrictHostKeyChecking=no -i /tmp/stolen_root_key root@127.0.0.1 id -u", "user": "ubuntu" }
      ]
    },
    {
